# Copia este archivo como .env y ajústalo. El .env NUNCA se sube al repositorio.

# Token que debe enviar el ESP32 (real o virtual) en cada petición.
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(24))"
DEVICE_TOKEN=cambia-este-token

# ---- Proveedores (todos gratuitos) ----
# STT: whisper_local | groq | falso
STT_PROVEEDOR=whisper_local
# Modelos de Whisper local: tiny, base, small (más grande = más preciso y más lento)
WHISPER_MODELO=base

# LLM: ollama | groq | falso
LLM_PROVEEDOR=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=llama3.2:3b

# TTS: edge | gtts | falso
TTS_PROVEEDOR=edge
EDGE_VOZ=es-CO-SalomeNeural

# ---- Groq (opcional, clave gratuita en https://console.groq.com) ----
GROQ_API_KEY=
GROQ_MODELO_LLM=llama-3.1-8b-instant
GROQ_MODELO_STT=whisper-large-v3-turbo

# ---- Control de recursos ----
MAX_SEGUNDOS_GRABACION=10
LLM_MAX_TOKENS=200
MAX_CARACTERES_RESPUESTA=400
HISTORIAL_MAX_TURNOS=4
TIMEOUT_SERVICIOS_S=45

# Permite la cabecera X-Simular-Falla (pruebas de manejo de errores)
PERMITIR_SIMULACION_FALLAS=true
